# ============================================
# Pentaho Server 11 Compose Deployment (Podman)
# Environment Configuration Template (PostgreSQL)
# ============================================

# ----------------------------------------
# Pentaho Version
# ----------------------------------------
# Must match the ZIP file placed in image/stagedArtifacts/
PENTAHO_VERSION=11.0.0.0-237

# ----------------------------------------
# Image Settings
# ----------------------------------------
PENTAHO_IMAGE_NAME=pentaho/pentaho-server
PENTAHO_IMAGE_TAG=11.0.0.0-237

# ----------------------------------------
# PostgreSQL Configuration
# ----------------------------------------
# Password for PostgreSQL postgres user (change for production!)
POSTGRES_PASSWORD=password

# PostgreSQL port exposure
POSTGRES_PORT=5432

# ----------------------------------------
# Pentaho Server Ports
# ----------------------------------------
# HTTP port for Pentaho web interface
PENTAHO_HTTP_PORT=8090

# HTTPS port for secure access
PENTAHO_HTTPS_PORT=8443

# ----------------------------------------
# JVM Memory Settings
# ----------------------------------------
# Minimum heap size
PENTAHO_MIN_MEMORY=4096m

# Maximum heap size (adjust based on available RAM)
PENTAHO_MAX_MEMORY=8192m

# ----------------------------------------
# License Configuration (Optional)
# ----------------------------------------
# URL the entrypoint installs an Enterprise license from. Left empty, the
# server starts unlicensed: sign in and add a license under Administration >
# Licenses (an activation code or your licensing URL)
# Example: LICENSE_URL=http://your-server/pentaho-ee-license.lic
LICENSE_URL=

# ----------------------------------------
# Installation Paths (Internal - Do Not Modify)
# ----------------------------------------
# These match the Containerfile configuration
INSTALLATION_PATH=/opt/pentaho
PENTAHO_SERVER_PATH=/opt/pentaho/pentaho-server

# ============================================
# Production Deployment Notes:
# ============================================
# 1. Change POSTGRES_PASSWORD to a strong password
# 2. Consider restricting POSTGRES_PORT exposure (remove from compose.yaml)
# 3. Adjust JVM memory based on workload and available resources
# 4. Configure firewall rules for exposed ports
# 5. Set up SSL/TLS certificates for HTTPS
# ============================================

  <step>
    <name>vs-matches</name>
    <type>VSearch</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <STORE_TYPE>PGVector</STORE_TYPE>
    <URL/>
    <HOST>${PG_HOST}</HOST>
    <PORT>${PG_PORT}</PORT>
    <USE_TLS>N</USE_TLS>
    <DATABASE>${PG_DATABASE}</DATABASE>
    <SCHEMA/>
    <COLLECTION>kb_chunks</COLLECTION>
    <USERNAME>${PG_USER}</USERNAME>
    <PASSWORD>${PG_PASSWORD}</PASSWORD>
    <API_KEY>Encrypted </API_KEY>
    <NAMESPACE/>
    <CLOUD/>
    <REGION/>
    <PROJECT_ID/>
    <CLUSTER/>
    <INSTANCE/>
    <IP_TYPE/>
    <QUERY_VECTOR_FIELD>embedding</QUERY_VECTOR_FIELD>
    <MAX_RESULTS>${TOP_K}</MAX_RESULTS>
    <MIN_SCORE>${MIN_SCORE}</MIN_SCORE>
    <DIMENSION>768</DIMENSION>
    <OUTPUT_MODE>One row per match</OUTPUT_MODE>
    <KEEP_ROWS_WITHOUT_MATCH>Y</KEEP_ROWS_WITHOUT_MATCH>
    <RANK_FIELD>match_rank</RANK_FIELD>
    <SCORE_FIELD>match_score</SCORE_FIELD>
    <ID_FIELD>match_id</ID_FIELD>
    <TEXT_FIELD>match_text</TEXT_FIELD>
    <METADATA_FIELD>match_metadata</METADATA_FIELD>
    <EMBEDDING_FIELD/>
    <MATCHES_FIELD>matches</MATCHES_FIELD>
    <MATCH_COUNT_FIELD>match_count</MATCH_COUNT_FIELD>
    <STOP_ON_ERROR>Y</STOP_ON_ERROR>
    <metadata_output_field>
      <OUTPUT_METADATA_KEY>source</OUTPUT_METADATA_KEY>
      <OUTPUT_FIELD_NAME>match_source</OUTPUT_FIELD_NAME>
      <OUTPUT_FIELD_TYPE>String</OUTPUT_FIELD_TYPE>

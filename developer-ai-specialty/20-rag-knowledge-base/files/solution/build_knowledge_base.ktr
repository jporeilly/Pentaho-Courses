  <step>
    <name>seg-chunks</name>
    <type>AiToken</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <INPUT_FIELD_NAME>doc_text</INPUT_FIELD_NAME>
    <SEGMENTATION_SPLIT_STRATEGY>Split by Recursion (Paragraph &gt; Line &gt; Sentence &gt; Word)</SEGMENTATION_SPLIT_STRATEGY>
    <CONFIG_USING_TOKENS>Y</CONFIG_USING_TOKENS>
    <LLM_PROVIDER>Ollama</LLM_PROVIDER>
    <LLM_MODEL_NAME>${MODEL_NAME}</LLM_MODEL_NAME>
    <MAX_SEGMENTATION_SIZE_IN_TOKENS>300</MAX_SEGMENTATION_SIZE_IN_TOKENS>
    <MAX_OVERLAP_SIZE_IN_TOKENS>30</MAX_OVERLAP_SIZE_IN_TOKENS>
    <MAX_SEGMENTATION_SIZE_IN_CHARS>1024</MAX_SEGMENTATION_SIZE_IN_CHARS>
    <MAX_OVERLAP_SIZE_IN_CHARS>0</MAX_OVERLAP_SIZE_IN_CHARS>
    <REGEX_PATTERN/>
    <REGEX_JOIN_DELIMITER>,</REGEX_JOIN_DELIMITER>
    <OUTPUT_FIELD>chunk</OUTPUT_FIELD>
    <OUTPUT_METADATA_FIELD>Y</OUTPUT_METADATA_FIELD>
    <STOP_ON_ERROR>Y</STOP_ON_ERROR>
    <attributes/>
    <cluster_schema/>
    <remotesteps>

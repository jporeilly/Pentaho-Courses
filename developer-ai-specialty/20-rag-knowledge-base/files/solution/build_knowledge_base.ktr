  <step>
    <name>emb-chunks</name>
    <type>AiEmbedding</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <INPUT_FROM_STREAM>Y</INPUT_FROM_STREAM>
    <INPUT_TEXT>This is a test message</INPUT_TEXT>
    <TEXT_FIELD>chunk</TEXT_FIELD>
    <ID_FIELD>chunk_id</ID_FIELD>
    <metadata_field>
      <METADATA_FIELD_NAME>short_filename</METADATA_FIELD_NAME>
      <METADATA_KEY>source</METADATA_KEY>

<transformation>
  <info>
    <name>evaluate_rag</name>
    <description/>
    <extended_description/>
    <trans_version/>
    <trans_type>Normal</trans_type>
    <trans_status>0</trans_status>
    <directory>/</directory>
    <parameters>
      <parameter>
        <name>MODEL_NAME</name>
        <default_value>llama3.2:3b</default_value>
        <description>Ollama chat model that answers (the model under test)</description>
      </parameter>
      <parameter>
        <name>JUDGE_MODEL</name>
        <default_value>qwen2.5:7b</default_value>
        <description>Ollama chat model that grades the answers (stronger than MODEL_NAME)</description>
      </parameter>
      <parameter>
        <name>OLLAMA_URL</name>
        <default_value>http://localhost:11434</default_value>
        <description>Ollama server</description>
      </parameter>
      <parameter>
        <name>PG_HOST</name>
        <default_value>localhost</default_value>
        <description>pgvector host (lab kit: localhost)</description>
      </parameter>
      <parameter>
        <name>PG_PORT</name>
        <default_value>5433</default_value>
        <description>pgvector port (lab kit: 5433; 5432 is the Pentaho repository)</description>
      </parameter>
      <parameter>
        <name>PG_DATABASE</name>
        <default_value>genai</default_value>
        <description>Database</description>
      </parameter>
      <parameter>
        <name>PG_USER</name>
        <default_value>genai</default_value>
        <description>User</description>
      </parameter>
      <parameter>
        <name>PG_PASSWORD</name>
        <default_value>genai</default_value>
        <description>Password</description>
      </parameter>
      <parameter>
        <name>TOP_K</name>
        <default_value>4</default_value>
        <description>Passages retrieved per question: the largest top_k in dg-settings</description>
      </parameter>
      <parameter>
        <name>MIN_SCORE</name>
        <default_value>0.75</default_value>
        <description>Lowest score a passage needs, 0 to 1 ((1 + cosine similarity) / 2)</description>
      </parameter>
    </parameters>

        <type>SUM</type>
        <valuefield/>
      </field>
      <field>
        <aggregate>correct</aggregate>
        <subject>is_correct</subject>
        <type>SUM</type>
        <valuefield/>
      </field>
      <field>
        <aggregate>partial</aggregate>
        <subject>is_partial</subject>
        <type>SUM</type>
        <valuefield/>
      </field>
      <field>
        <aggregate>correct_declines</aggregate>
        <subject>is_declined_ok</subject>
        <type>SUM</type>
        <valuefield/>
      </field>
      <field>
        <aggregate>faithful_n</aggregate>
        <subject>is_faithful</subject>
        <type>SUM</type>
        <valuefield/>
      </field>
      <field>
        <aggregate>wrong_declines</aggregate>
        <subject>is_wrong_decline</subject>

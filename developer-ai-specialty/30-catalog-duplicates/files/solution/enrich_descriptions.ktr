    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>// a number in the new description that is not in the record is a fact the model invented
var facts = (title + " " + brand + " " + category + " " + price).toLowerCase();
var found = (new_description == null) ? null : String(new_description).match(/\d+(\.\d+)?/g);
var invented = [];
if (found != null) {
  for (var i = 0; i &lt; found.length; i++) {
    if (facts.indexOf(found[i]) &lt; 0 &amp;&amp; invented.indexOf(found[i]) &lt; 0) {
      invented.push(found[i]);
    }
  }
}
var unsupported_numbers = invented.join(" ");</jsScript_script>
      </jsScript>
    </jsScripts>

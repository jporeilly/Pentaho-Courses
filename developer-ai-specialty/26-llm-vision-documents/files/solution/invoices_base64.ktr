  <step>
    <name>const-instruction</name>
    <type>Constant</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>run_instruction</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif>You read one scanned business document: an invoice, a receipt, or something else.
Answer with one JSON object and nothing else, without code fences, in exactly this shape:
{"supplier": "the company that issued the document", "invoice_number": "the invoice or receipt number as printed", "invoice_date": "the date as YYYY-MM-DD", "currency": "a three-letter code such as USD, EUR or GBP", "subtotal": the amount before tax as a number, "tax": the tax amount as a number, "total": the amount due as a number, "line_count": the number of line items as an integer, "is_invoice": true for an invoice or a receipt, otherwise false}
Write numbers without currency symbols or thousands separators, with a dot for decimals.
Copy the figures exactly as printed; do not calculate or correct them.
If the document is not an invoice or a receipt, set is_invoice to false and every other value to null.</nullif>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
      <field>
        <name>message</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif>Read the attached document and return the JSON object.</nullif>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>520</xloc>
      <yloc>466</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>ai-invoice</name>
    <type>AiChat</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <USER_MESSAGE_FROM_NATIVE>N</USER_MESSAGE_FROM_NATIVE>
    <USER_MESSAGE></USER_MESSAGE>
    <USER_MESSAGE_FROM_STREAM>message</USER_MESSAGE_FROM_STREAM>
    <SYSTEM_MESSAGE>You are a helpful assistant</SYSTEM_MESSAGE>
    <SYSTEM_MESSAGE_FROM_STREAM>run_instruction</SYSTEM_MESSAGE_FROM_STREAM>
    <DOCUMENT_ATTACHMENT_NEEDED>Y</DOCUMENT_ATTACHMENT_NEEDED>
    <DOCUMENT_INPUT_FROM_FILE>N</DOCUMENT_INPUT_FROM_FILE>
    <DOCUMENT_INPUT_FILE/>
    <DOCUMENT_INPUT_FROM_IMAGE_FILE>N</DOCUMENT_INPUT_FROM_IMAGE_FILE>
    <DOCUMENT_INPUT_IMAGE_FILE/>
    <DOCUMENT_INPUT_FILE_FROM_STREAM_FIELD_FORMAT>Image (Base64 Encoded)</DOCUMENT_INPUT_FILE_FROM_STREAM_FIELD_FORMAT>
    <DOCUMENT_INPUT_FILE_FROM_STREAM>image_b64</DOCUMENT_INPUT_FILE_FROM_STREAM>
    <LLM_PROVIDER>Ollama</LLM_PROVIDER>
    <LLM_MODEL>${VISION_MODEL}</LLM_MODEL>
    <MODEL_API_KEY>Encrypted </MODEL_API_KEY>
    <SECRET_ACCESS_KEY>Encrypted </SECRET_ACCESS_KEY>
    <MODEL_ORG_ID/>
    <MODEL_ENDPOINT>${OLLAMA_URL}</MODEL_ENDPOINT>
    <MODEL_TEMPERATURE>0</MODEL_TEMPERATURE>
    <MODEL_USE_MODERATION>N</MODEL_USE_MODERATION>
    <MODEL_TOKEN_CRED_CLIENT_ID>Encrypted </MODEL_TOKEN_CRED_CLIENT_ID>
    <model_parameter>
      <MODEL_PARAMETER_NAME>numCtx</MODEL_PARAMETER_NAME>
      <MODEL_PARAMETER_VALUE>4096</MODEL_PARAMETER_VALUE>
    </model_parameter>
    <model_parameter>
      <MODEL_PARAMETER_NAME>timeout</MODEL_PARAMETER_NAME>
      <MODEL_PARAMETER_VALUE>300</MODEL_PARAMETER_VALUE>
    </model_parameter>
    <EMBEDDING_MODELS>text-embedding-3-small</EMBEDDING_MODELS>
    <PROXY_HOST/>

    </hop>
    <hop>
      <from>sv-results</from>
      <to>txt-results</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <step>
    <name>csvi-customers</name>
    <type>CsvInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <filename>${Internal.Entry.Current.Directory}/../data_enrichment_customers.csv</filename>
    <filename_field/>
    <rownum_field/>
    <include_filename>N</include_filename>
    <separator>,</separator>
    <enclosure>"</enclosure>
    <header>Y</header>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <newline_possible>N</newline_possible>
    <format>mixed</format>
    <encoding/>
    <fields>
      <field>
        <name>customer_id</name>
        <type>String</type>
        <format/>
        <currency>$</currency>
        <decimal>.</decimal>
        <group>,</group>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>name</name>
        <type>String</type>
        <format/>
        <currency>$</currency>
        <decimal>.</decimal>
        <group>,</group>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>email</name>
        <type>String</type>
        <format/>
        <currency>$</currency>
        <decimal>.</decimal>
        <group>,</group>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>phone</name>
        <type>String</type>
        <format/>
        <currency>$</currency>
        <decimal>.</decimal>
        <group>,</group>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>address</name>
        <type>String</type>
        <format/>
        <currency>$</currency>
        <decimal>.</decimal>
        <group>,</group>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>company_name</name>
        <type>String</type>
        <format/>
        <currency>$</currency>
        <decimal>.</decimal>
        <group>,</group>
        <length>-1</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>160</xloc>
      <yloc>412</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>ai-template</name>
    <type>AiMessageBox</type>
    <description/>
    <distribute>N</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <INPUT_PROMPT>Infer the missing details of this customer from the values the record has.</INPUT_PROMPT>
    <INPUT_PROMPT_RESULT_FIELD>task</INPUT_PROMPT_RESULT_FIELD>
    <SYSTEM_PROMPT>You enrich one customer record from a US customer file. Use only what the record says.
city and state: read them from the address, the state as a two-letter code; when the address does not say, use UNKNOWN.
country: USA unless the record says otherwise.
industry: one of ${INDUSTRY_LIST}, judged from the company name and the email domain.
employee_range: one of ${EMPLOYEE_RANGES}, estimated from the company name; UNKNOWN when the name gives no clue.
Answer with one JSON object and nothing else, in exactly this shape:
{"city": "...", "state": "XX", "country": "...", "industry": "...", "industry_basis": "the words in the record that suggest the industry", "employee_range": "..."}</SYSTEM_PROMPT>
    <SYSTEM_PROMPT_RESULT_FIELD>run_instruction</SYSTEM_PROMPT_RESULT_FIELD>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>320</xloc>
      <yloc>412</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>js-message</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>// The task from ai-template, then the customer's values as labeled lines
var customer_message = task + "\n\n" +
  "Company: " + company_name + "\n" +
  "Email: " + email + "\n" +
  "Phone: " + phone + "\n" +
  "Address: " + address;</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field>
        <name>customer_message</name>
        <rename>customer_message</rename>
        <type>String</type>
        <length>-1</length>
        <precision>-1</precision>
        <replace>N</replace>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>480</xloc>
      <yloc>412</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>ai-enrich</name>
    <type>AiChat</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>${STEP_COPIES}</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <USER_MESSAGE_FROM_NATIVE>N</USER_MESSAGE_FROM_NATIVE>
    <USER_MESSAGE></USER_MESSAGE>

        <default_value>http://localhost:11434</default_value>
        <description>Ollama server</description>
      </parameter>
      <parameter>
        <name>STEP_COPIES</name>
        <default_value>4</default_value>
        <description>Parallel copies of ai-enrich</description>
      </parameter>
      <parameter>
        <name>INDUSTRY_LIST</name>
        <default_value>Technology, Finance, Healthcare, Retail, Manufacturing, Services, Real Estate, Consulting</default_value>
        <description>The industries the model may choose from</description>
      </parameter>
      <parameter>
        <name>EMPLOYEE_RANGES</name>
        <default_value>1-10, 11-50, 51-200, 201-500, 501-1000, 1000+</default_value>
        <description>The company-size bands</description>
      </parameter>
    </parameters>

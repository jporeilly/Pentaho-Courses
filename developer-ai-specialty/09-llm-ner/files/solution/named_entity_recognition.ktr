  <step>
    <name>ner-corenlp</name>
    <type>NERExtractor</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <IS_INPUT_FROM_STREAM>Y</IS_INPUT_FROM_STREAM>
    <INPUT_TEXT>Charlie is working at a company called Pentaho in London, UK.</INPUT_TEXT>
    <INPUT_STREAM_FIELD_FORMAT>Binary Datum</INPUT_STREAM_FIELD_FORMAT>
    <INPUT_STREAM_FIELD_NAME>text</INPUT_STREAM_FIELD_NAME>
    <ANNOTATORS>tokenize,ssplit,pos,lemma,ner</ANNOTATORS>
    <APPLY_NUMERIC_CLASSIFIERS>Y</APPLY_NUMERIC_CLASSIFIERS>
    <USE_SUTIME>N</USE_SUTIME>
    <REGEX_NER_ENABLED>N</REGEX_NER_ENABLED>
    <REGEX_NER_MAPPING_FILE_PATH></REGEX_NER_MAPPING_FILE_PATH>
    <REGEX_NER_IGNORE_CASE>N</REGEX_NER_IGNORE_CASE>
    <REGEX_NER_BACKGROUND_SYMBOL>O,LOCATION,MISC,PERSON,ORGANIZATION</REGEX_NER_BACKGROUND_SYMBOL>
    <NUMBER_OF_THREADS>0</NUMBER_OF_THREADS>
    <BATCH_SIZE>1000</BATCH_SIZE>
    <OUTPUT_TYPE>JSON</OUTPUT_TYPE>
    <OUTPUT_FIELD_NAME>ner_json</OUTPUT_FIELD_NAME>
    <attributes/>
    <cluster_schema/>

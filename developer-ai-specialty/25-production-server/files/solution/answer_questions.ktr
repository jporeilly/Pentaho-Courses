  <step>
    <name>js-prompt</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>// matches: the JSON array Vector Search wrote for this question
var list = [];
if (matches != null &amp;&amp; String(matches) != "") {
  list = JSON.parse(String(matches));
}
var passages = [];
var sources = [];
for (var i = 0; i &lt; list.length; i++) {
  var md = list[i].metadata;
  if (typeof md == "string") {
    md = JSON.parse(md);
  }
  var src = (md != null &amp;&amp; md.source != null) ? String(md.source) : "unknown";
  passages.push("[" + (i + 1) + "] Source: " + src + "\n" + list[i].text);
  if (sources.indexOf(src) &lt; 0) {
    sources.push(src);
  }
}
var context = passages.length &gt; 0 ? passages.join("\n\n") : "(no passages were found)";
var prompt = "Context:\n" + context + "\n\nQuestion: " + question;
var retrieved_sources = sources.join(", ");</jsScript_script>
      </jsScript>
    </jsScripts>

  <step>
    <name>Get Asset History</name>
    <type>DBJoin</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>asset_history_db</connection>
    <rowlimit>10</rowlimit>
    <sql>SELECT
    logged_at  AS hist_logged_at,
    log_text   AS hist_log_text
FROM asset_history
WHERE asset_id = ?
ORDER BY logged_at ASC</sql>
    <outer_join>Y</outer_join>
    <replace_vars>N</replace_vars>
    <parameter>
      <field>
        <name>asset_id</name>
        <type>String</type>
      </field>
    </parameter>
    <attributes/>
    <cluster_schema/>

  <notepads>
    <notepad>
      <note>sentiment_analysis - asks a local LLM for the sentiment of each customer review and writes the answers as
fields.
Needs Ollama with ${MODEL_NAME} (llama3.2:3b) and the GenAI plugins with a GENAI-EE license.

1. csvi-reviews: CSV file input, ../customer_reviews.csv, five reviews.
2. const-instruction: Add constants, run_instruction: classify the review and answer with one JSON object
   (sentiment, score, confidence, key_phrases, summary).
3. ai-sentiment: AI Chat, ${STEP_COPIES} copies; Stream message review_text, run instruction
   run_instruction; Ollama ${MODEL_NAME} at ${OLLAMA_URL}, temperature 0, numCtx 2048, timeout 120;
   result llm_json.
4. json-sentiment: JSON input from llm_json: sentiment, score, confidence, key_phrases, summary.
5. sv-results: Select values, the review and its five sentiment fields, in order.
6. txt-results: Text file output, sentiment_results.csv beside this file.

Parameters: MODEL_NAME llama3.2:3b, OLLAMA_URL http://localhost:11434, STEP_COPIES 4.
Shipped data: 5 reviews; reviews 1 and 4 come back positive, 2 and 5 negative.
Error hop: json-sentiment sends an answer it cannot parse to txt-bad-answers: review_id, llm_json,
err_desc to bad_answers.csv beside this file (0 bytes when every answer parsed).</note>
      <xloc>160</xloc>
      <yloc>32</yloc>
      <width>627</width>
      <heigth>332</heigth>
      <fontname>Segoe UI</fontname>
      <fontsize>10</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>0</fontcolorred>
      <fontcolorgreen>0</fontcolorgreen>
      <fontcolorblue>0</fontcolorblue>
      <backgroundcolorred>167</backgroundcolorred>
      <backgroundcolorgreen>224</backgroundcolorgreen>
      <backgroundcolorblue>245</backgroundcolorblue>
      <bordercolorred>100</bordercolorred>
      <bordercolorgreen>100</bordercolorgreen>
      <bordercolorblue>100</bordercolorblue>
      <drawshadow>Y</drawshadow>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>csvi-reviews</from>
      <to>const-instruction</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>const-instruction</from>
      <to>ai-sentiment</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>ai-sentiment</from>
      <to>json-sentiment</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>json-sentiment</from>
      <to>sv-results</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>sv-results</from>
      <to>txt-results</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>json-sentiment</from>
      <to>txt-bad-answers</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <step>
    <name>csvi-reviews</name>
    <type>CsvInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <filename>${Internal.Entry.Current.Directory}/../customer_reviews.csv</filename>
    <filename_field/>
    <rownum_field/>
    <include_filename>N</include_filename>
    <separator>,</separator>
    <enclosure>"</enclosure>
    <header>Y</header>
    <buffer_size>50000</buffer_size>
    <lazy_conversion>N</lazy_conversion>
    <add_filename_result>N</add_filename_result>
    <parallel>N</parallel>
    <newline_possible>N</newline_possible>
    <format>mixed</format>
    <encoding/>
    <fields>
      <field>
        <name>review_id</name>
        <type>Integer</type>
        <format>#</format>
        <currency>$</currency>
        <decimal>.</decimal>
        <group>,</group>
        <length>15</length>
        <precision>0</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>customer_name</name>
        <type>String</type>
        <format/>
        <currency>$</currency>
        <decimal>.</decimal>
        <group>,</group>
        <length>100</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>product</name>
        <type>String</type>
        <format/>
        <currency>$</currency>
        <decimal>.</decimal>
        <group>,</group>
        <length>200</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>review_text</name>
        <type>String</type>
        <format/>
        <currency>$</currency>
        <decimal>.</decimal>
        <group>,</group>
        <length>5000</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
      <field>
        <name>date</name>
        <type>String</type>
        <format/>
        <currency>$</currency>
        <decimal>.</decimal>
        <group>,</group>
        <length>20</length>
        <precision>-1</precision>
        <trim_type>both</trim_type>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>160</xloc>
      <yloc>412</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>const-instruction</name>
    <type>Constant</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <fields>
      <field>
        <name>run_instruction</name>
        <type>String</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <nullif>You classify the sentiment of one customer review.
Answer with one JSON object and nothing else, in exactly this shape:
{"sentiment": "positive" | "negative" | "neutral", "score": a number from -1.0 to 1.0, "confidence": an integer from 0 to 100, "key_phrases": ["up to four short phrases from the review"], "summary": "one sentence"}</nullif>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>340</xloc>
      <yloc>412</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>ai-sentiment</name>
    <type>AiChat</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>${STEP_COPIES}</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <USER_MESSAGE_FROM_NATIVE>N</USER_MESSAGE_FROM_NATIVE>
    <USER_MESSAGE></USER_MESSAGE>
    <USER_MESSAGE_FROM_STREAM>review_text</USER_MESSAGE_FROM_STREAM>
    <SYSTEM_MESSAGE>You are a helpful assistant</SYSTEM_MESSAGE>
    <SYSTEM_MESSAGE_FROM_STREAM>run_instruction</SYSTEM_MESSAGE_FROM_STREAM>
    <DOCUMENT_ATTACHMENT_NEEDED>N</DOCUMENT_ATTACHMENT_NEEDED>
    <DOCUMENT_INPUT_FROM_FILE>Y</DOCUMENT_INPUT_FROM_FILE>
    <DOCUMENT_INPUT_FILE/>
    <DOCUMENT_INPUT_FROM_IMAGE_FILE>N</DOCUMENT_INPUT_FROM_IMAGE_FILE>
    <DOCUMENT_INPUT_IMAGE_FILE/>
    <DOCUMENT_INPUT_FILE_FROM_STREAM_FIELD_FORMAT>File</DOCUMENT_INPUT_FILE_FROM_STREAM_FIELD_FORMAT>
    <DOCUMENT_INPUT_FILE_FROM_STREAM></DOCUMENT_INPUT_FILE_FROM_STREAM>
    <LLM_PROVIDER>Ollama</LLM_PROVIDER>
    <LLM_MODEL>${MODEL_NAME}</LLM_MODEL>
    <MODEL_API_KEY>Encrypted </MODEL_API_KEY>
    <SECRET_ACCESS_KEY>Encrypted </SECRET_ACCESS_KEY>
    <MODEL_ORG_ID/>
    <MODEL_ENDPOINT>${OLLAMA_URL}</MODEL_ENDPOINT>
    <MODEL_TEMPERATURE>0</MODEL_TEMPERATURE>
    <MODEL_USE_MODERATION>N</MODEL_USE_MODERATION>
    <MODEL_TOKEN_CRED_CLIENT_ID>Encrypted </MODEL_TOKEN_CRED_CLIENT_ID>
    <model_parameter>
      <MODEL_PARAMETER_NAME>numCtx</MODEL_PARAMETER_NAME>
      <MODEL_PARAMETER_VALUE>2048</MODEL_PARAMETER_VALUE>
    </model_parameter>
    <model_parameter>
      <MODEL_PARAMETER_NAME>timeout</MODEL_PARAMETER_NAME>
      <MODEL_PARAMETER_VALUE>120</MODEL_PARAMETER_VALUE>
    </model_parameter>
    <EMBEDDING_MODELS>nomic-embed-text</EMBEDDING_MODELS>
    <PROXY_HOST/>
    <PROXY_PORT>0</PROXY_PORT>
    <PROXY_USERNAME/>
    <PROXY_PASSWORD>Encrypted </PROXY_PASSWORD>
    <RESPONSE_OUTPUT_TYPE>text</RESPONSE_OUTPUT_TYPE>
    <GENERATED_OUTPUT_FIELD>llm_json</GENERATED_OUTPUT_FIELD>
    <PASS_EMBEDDINGS_TO_STREAM>N</PASS_EMBEDDINGS_TO_STREAM>
    <PASS_EMBEDDINGS_UUID_TO_STREAM>N</PASS_EMBEDDINGS_UUID_TO_STREAM>
    <DOCUMENT_CHARACTER_ENCODING>UTF-8</DOCUMENT_CHARACTER_ENCODING>

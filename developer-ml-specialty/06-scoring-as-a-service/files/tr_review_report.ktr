  <notepads>
    <notepad>
      <note>tr_review_report - turns tonight's scores into the analysts' workbook:
output/fraud_review_&lt;yyyyMMdd&gt;.xlsx.
Run after tr_score_orders; needs the fraud database and fraud_review_template.xlsx beside it. Parameters:
THRESHOLD (0.15), COST_REVIEW (25).

1. tbl-review_queue: Table input, the flagged orders from order_scores, highest fraud_probability first.
2. vm-reason_in_words: Value mapper, top_reason to why_flagged in plain words.
3. frmla-band: Formula, High at 0.5 or more, else Review.
4. xls-review_queue: Microsoft Excel writer, a new workbook from the template, sheet Review Queue from
   A2, no header.
5. tbl-summary: Table input, one row of tonight's figures.
6. blk-wait_for_queue: Block this step until steps finish, waits for xls-review_queue.
7. xls-summary: Microsoft Excel writer, the same workbook, sheet Summary from A5.

Shipped data: 2,000 scored, 28 flagged, 12.2 expected frauds, highest risk 98.8%, review cost $700; the
template colors High rows red and the rest amber.</note>
      <xloc>96</xloc>
      <yloc>32</yloc>
      <width>627</width>
      <heigth>296</heigth>
      <fontname>Segoe UI</fontname>
      <fontsize>10</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>0</fontcolorred>
      <fontcolorgreen>0</fontcolorgreen>
      <fontcolorblue>0</fontcolorblue>
      <backgroundcolorred>167</backgroundcolorred>
      <backgroundcolorgreen>224</backgroundcolorgreen>
      <backgroundcolorblue>245</backgroundcolorblue>
      <bordercolorred>100</bordercolorred>
      <bordercolorgreen>100</bordercolorgreen>
      <bordercolorblue>100</bordercolorblue>
      <drawshadow>Y</drawshadow>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>tbl-review_queue</from>
      <to>vm-reason_in_words</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>vm-reason_in_words</from>
      <to>frmla-band</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>frmla-band</from>
      <to>xls-review_queue</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>tbl-summary</from>
      <to>blk-wait_for_queue</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>blk-wait_for_queue</from>
      <to>xls-summary</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <step>
    <name>tbl-review_queue</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>fraud</connection>
    <sql>SELECT transaction_id,
       customer_id,
       order_dollar_amount,
       fraud_probability,
       top_reason,
       DATE_FORMAT(scored_at, '%Y-%m-%d %H:%i') AS scored_at
FROM order_scores
WHERE flagged = 1
ORDER BY fraud_probability DESC</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>96</xloc>
      <yloc>376</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>vm-reason_in_words</name>
    <type>ValueMapper</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <field_to_use>top_reason</field_to_use>
    <target_field>why_flagged</target_field>
    <non_match_default>See the order's details</non_match_default>
    <fields>
      <field>
        <source_value>billing_shipping_zip_equal</source_value>
        <target_value>Shipped to a different address than billing</target_value>
      </field>
      <field>
        <source_value>first_time_customer</source_value>
        <target_value>First order from this customer</target_value>
      </field>
      <field>
        <source_value>hour_of_day</source_value>
        <target_value>Placed late at night</target_value>
      </field>
      <field>
        <source_value>order_dollar_amount</source_value>
        <target_value>Unusually large order</target_value>
      </field>
      <field>
        <source_value>age</source_value>
        <target_value>Customer in a high-risk age band</target_value>
      </field>
      <field>
        <source_value>num_items</source_value>
        <target_value>Many items in one order</target_value>
      </field>
      <field>
        <source_value>total_transactions_to_date</source_value>
        <target_value>Little purchase history</target_value>
      </field>
      <field>
        <source_value>web_order</source_value>
        <target_value>Web order</target_value>
      </field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>288</xloc>
      <yloc>376</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>frmla-band</name>
    <type>Formula</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <formula>
      <field_name>band</field_name>
      <formula_string>IF([fraud_probability]&gt;=0.5;"High";"Review")</formula_string>
      <value_type>String</value_type>
      <value_length>-1</value_length>
      <value_precision>-1</value_precision>
      <replace_field></replace_field>
    </formula>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>480</xloc>
      <yloc>376</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>xls-review_queue</name>
    <type>TypeExitExcelWriterStep</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <header>N</header>
    <footer>N</footer>
    <makeSheetActive>N</makeSheetActive>
    <rowWritingMethod>overwrite</rowWritingMethod>
    <startingCell>A2</startingCell>
    <appendOmitHeader>N</appendOmitHeader>
    <appendOffset>0</appendOffset>
    <appendEmpty>0</appendEmpty>
    <rowWritingMethod>overwrite</rowWritingMethod>
    <forceFormulaRecalculation>N</forceFormulaRecalculation>
    <leaveExistingStylesUnchanged>N</leaveExistingStylesUnchanged>
    <extend_data_validation>N</extend_data_validation>
    <retain_null_values>N</retain_null_values>
    <create_parent>Y</create_parent>
    <appendLines>N</appendLines>
    <add_to_result_filenames>Y</add_to_result_filenames>
    <file>
      <name>${Internal.Entry.Current.Directory}/output/fraud_review</name>
      <extention>xlsx</extention>

    <sql>SELECT CURRENT_DATE() AS report_date,
       COUNT(*) AS orders_scored,
       SUM(flagged) AS flagged,
       ${THRESHOLD} AS threshold,
       SUM(CASE WHEN flagged = 1 THEN fraud_probability ELSE 0 END) AS expected_frauds,
       MAX(fraud_probability) AS highest_risk,
       SUM(flagged) * ${COST_REVIEW} AS review_cost
FROM order_scores</sql>

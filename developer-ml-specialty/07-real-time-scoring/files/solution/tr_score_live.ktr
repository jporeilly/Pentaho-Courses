  <step>
    <name>py-score_live</name>
    <type>PythonExecutor</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <step-props secure="">
      <group name="">
        <property group="" name="SCRIPT">
          <value xsi:type="xs:string">import h2o

# Connect to the running scoring service: no H2O to start, no model to load
h2o.connect(url="${SERVICE_URL}", verbose=False)
gbm = h2o.get_model("${MODEL_ID}")
threshold = float("${THRESHOLD}")

# This batch of orders, as the Kafka consumer handed it over
frame = h2o.H2OFrame(batch.drop(columns=["partition", "offset"]))
pred_frame = gbm.predict(frame)
contrib_frame = gbm.predict_contributions(frame)
pred = pred_frame.as_data_frame(use_multi_thread=True)
contrib = contrib_frame.as_data_frame(use_multi_thread=True)

scored = batch[["transaction_id", "customer_id", "order_dollar_amount", "partition", "offset"]].copy()
scored["fraud_probability"] = pred["p1"].round(4).values
scored["flagged"] = (pred["p1"] &gt;= threshold).astype("int64").values
scored["top_reason"] = contrib.drop(columns=["BiasTerm"]).idxmax(axis=1).values

# The service keeps running: remove the three frames this batch made in it
h2o.remove([frame, pred_frame, contrib_frame])
</value>
        </property>
        <property group="" name="LOAD_SCRIPT_AT_RUNTIME">
          <value xsi:type="xs:boolean">false</value>
        </property>
        <property group="" name="SCRIPT_TO_LOAD">
          <value xsi:type="xs:string"/>
        </property>
        <property group="" name="OUTPUT_FRAME_VARIABLE">
          <value xsi:type="xs:string">scored</value>
        </property>

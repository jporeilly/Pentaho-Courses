  <notepads>
    <notepad>
      <note>tr_live_orders - the parent: reads the Kafka topic orders without end and runs tr_score_live.ktr for every
batch.
Needs Kafka (C:/Streaming/run-podman-streaming.ps1 -Topic orders) and the H2O scoring service with
the model published.

1. Kafka consumer: 127.0.0.1:9092, topic orders, group fraud-scoring; batches of 100 records or 1000 ms,
   one at a time; offsets committed when the batch completes; auto.offset.reset earliest.

Shipped data: 500 orders from live_orders.jsonl arrive as five batches of 100. Stop it with Stop in Spoon.</note>
      <xloc>64</xloc>
      <yloc>32</yloc>
      <width>626</width>
      <heigth>170</heigth>
      <fontname>Segoe UI</fontname>
      <fontsize>10</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>0</fontcolorred>
      <fontcolorgreen>0</fontcolorgreen>
      <fontcolorblue>0</fontcolorblue>
      <backgroundcolorred>167</backgroundcolorred>
      <backgroundcolorgreen>224</backgroundcolorgreen>
      <backgroundcolorblue>245</backgroundcolorblue>
      <bordercolorred>100</bordercolorred>
      <bordercolorgreen>100</bordercolorgreen>
      <bordercolorblue>100</bordercolorblue>
      <drawshadow>Y</drawshadow>
    </notepad>
  </notepads>
  <order>
  </order>
  <step>
    <name>Kafka consumer</name>
    <type>KafkaConsumerInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <clusterName/>
    <topic>orders</topic>
    <consumerGroup>fraud-scoring</consumerGroup>
    <transformationPath>${Internal.Entry.Current.Directory}/tr_score_live.ktr</transformationPath>
    <SUB_STEP/>
    <batchSize>100</batchSize>
    <batchDuration>1000</batchDuration>
    <PARALLELISM>1</PARALLELISM>
    <prefetchMessageCount>100000</prefetchMessageCount>
    <connectionType>DIRECT</connectionType>
    <directBootstrapServers>127.0.0.1:9092</directBootstrapServers>
    <AUTO_COMMIT>N</AUTO_COMMIT>
    <OutputField kafkaName="key" type="String">key</OutputField>
    <OutputField kafkaName="message" type="String">message</OutputField>
    <OutputField kafkaName="topic" type="String">topic</OutputField>
    <OutputField kafkaName="partition" type="Integer">partition</OutputField>
    <OutputField kafkaName="offset" type="Integer">offset</OutputField>
    <OutputField kafkaName="timestamp" type="Integer">timestamp</OutputField>
    <advancedConfig>
      <option property="auto.offset.reset" value="earliest"/>
      <option property="ssl.key.password" value=""/>
      <option property="ssl.keystore.location" value=""/>
      <option property="ssl.keystore.password" value=""/>
      <option property="ssl.truststore.location" value=""/>
      <option property="ssl.truststore.password" value=""/>
    </advancedConfig>
    <attributes/>
    <cluster_schema/>
    <remotesteps>

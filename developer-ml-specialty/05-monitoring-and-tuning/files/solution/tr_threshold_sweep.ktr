    </hop>
  </order>
  <step>
    <name>tbl-scores_and_outcomes</name>
    <type>TableInput</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>fraud</connection>
    <sql>SELECT s.transaction_id,
       s.fraud_probability,
       o.confirmed_fraud
FROM transaction_scores s
JOIN confirmed_outcomes o ON o.transaction_id = s.transaction_id</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>Y</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
    <cached_row_meta_active>N</cached_row_meta_active>
    <attributes/>
    <cluster_schema/>
    <remotesteps>
      <input>
      </input>
      <output>
      </output>
    </remotesteps>
    <GUI>
      <xloc>96</xloc>
      <yloc>376</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>dg-thresholds</name>
    <type>DataGrid</type>
    <description/>
    <distribute>Y</distribute>

        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <set_empty_string>N</set_empty_string>
      </field>
    </fields>
    <data>
      <line>
        <item>0.02</item>
      </line>
      <line>
        <item>0.05</item>
      </line>
      <line>
        <item>0.1</item>

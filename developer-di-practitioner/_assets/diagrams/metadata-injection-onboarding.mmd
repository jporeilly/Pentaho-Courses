%%{init: {"theme":"base","themeVariables":{"fontFamily":"Segoe UI, Helvetica, Arial, sans-serif","fontSize":"13px","lineColor":"#64748b","clusterBkg":"#fafaf9","clusterBorder":"#d6d3d1","edgeLabelBackground":"#ffffff"},"flowchart":{"curve":"linear","nodeSpacing":20,"rankSpacing":48,"padding":10,"htmlLabels":true}}}%%
flowchart TB
  classDef input fill:#dbeafe,stroke:#1d4ed8,color:#1e3a8a,text-align:left,rx:6,ry:6
  classDef enrich fill:#ede9fe,stroke:#6d28d9,color:#3b0764,text-align:left,rx:6,ry:6
  classDef inject fill:#ccfbf1,stroke:#0f766e,color:#134e4a,text-align:left,rx:6,ry:6
  classDef output fill:#dcfce7,stroke:#15803d,color:#14532d,text-align:left,rx:6,ry:6
  subgraph injector ["metadata_inject_step.ktr: the metadata"]
    direction LR
    D["<div style='width:150px'><b>Generate rows</b><br/>gr-filename</div>"]:::input
    A["<div style='width:240px'><b>Data grid</b><br/>dg-metadata_fields<br/>one row per field of customers.txt</div>"]:::input
    B["<div style='width:240px'><b>Data grid</b><br/>dg-rename<br/>id to key_id</div>"]:::input
    C["<div style='width:240px'><b>Data grid</b><br/>dg_remove_name<br/>stateCode</div>"]:::input
    E["<div style='width:240px'><b>Set field value to a constant</b><br/>sfvc-path_filename<br/>data/customers.txt</div>"]:::enrich
    M["<div style='width:240px'><b>ETL metadata injection</b><br/>template: metadata_inject_template.ktr<br/>run resulting transformation</div>"]:::inject
    D ~~~ A
    D ~~~ B
    D ~~~ C
    D --> E
    A --> M
    B --> M
    C --> M
    E --> M
  end
  subgraph template ["metadata_inject_template.ktr: the shape"]
    direction LR
    T1["<div style='width:250px'><b>CSV file input</b><br/>csvi-mdi<br/>no file, no fields</div>"]:::input
    T2["<div style='width:250px'><b>Select values</b><br/>sv-mdi<br/>empty</div>"]:::enrich
    T3["<div style='width:250px'><b>Table output</b><br/>to-metadata_injection_customers<br/>table:<br/>METADATA_INJECTION_CUSTOMERS</div>"]:::output
    T1 --> T2 --> T3
  end
  injector -.->|"fills in the template's settings, then runs it"| template

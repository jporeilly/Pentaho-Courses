%%{init: {"theme":"base","themeVariables":{"fontFamily":"Segoe UI, Helvetica, Arial, sans-serif","fontSize":"13px","lineColor":"#64748b","clusterBkg":"#fafaf9","clusterBorder":"#d6d3d1","edgeLabelBackground":"#ffffff"},"flowchart":{"curve":"basis","nodeSpacing":16,"rankSpacing":40,"padding":10,"htmlLabels":true}}}%%
flowchart LR
  classDef input fill:#dbeafe,stroke:#1d4ed8,color:#1e3a8a,text-align:left,rx:6,ry:6
  classDef enrich fill:#ede9fe,stroke:#6d28d9,color:#3b0764,text-align:left,rx:6,ry:6
  classDef join fill:#ccfbf1,stroke:#0f766e,color:#134e4a,text-align:left,rx:6,ry:6
  classDef output fill:#dcfce7,stroke:#15803d,color:#14532d,text-align:left,rx:6,ry:6
  classDef server fill:#f1f5f9,stroke:#475569,color:#0f172a,text-align:left,rx:6,ry:6
  subgraph SRC["Data sources&nbsp;&nbsp;"]
    direction TB
    F["<b>Flat files</b>&nbsp;&nbsp;<br/>CSV, TXT, JSON, XML&nbsp;&nbsp;"]:::input
    R["<b>Relational databases</b>&nbsp;&nbsp;<br/>Oracle, PostgreSQL, MySQL&nbsp;&nbsp;"]:::input
    L["<b>Data lake / lakehouse</b>&nbsp;&nbsp;<br/>Redshift, BigQuery&nbsp;&nbsp;"]:::input
    O["<b>Object stores</b>&nbsp;&nbsp;<br/>S3, GCS&nbsp;&nbsp;"]:::input
    A["<b>APIs</b>&nbsp;&nbsp;"]:::input
  end
  subgraph ENG["Data engineering / IT&nbsp;&nbsp;"]
    direction TB
    ST["<b>Staging layer</b>&nbsp;&nbsp;<br/>Pentaho Data Integration&nbsp;&nbsp;"]:::enrich
    TR["<b>Transformation layer</b>&nbsp;&nbsp;<br/>Pentaho Data Integration&nbsp;&nbsp;"]:::enrich
  end
  subgraph MOD["Modelling layer: data modellers&nbsp;&nbsp;"]
    direction TB
    CU["<b>Pentaho OLAP cube</b>&nbsp;&nbsp;<br/>dimensional modelling&nbsp;&nbsp;"]:::join
    DM["<b>Enterprise data mart</b>&nbsp;&nbsp;<br/>data lake, lakehouse&nbsp;&nbsp;"]:::join
  end
  subgraph VIS["Visualization layer: business users&nbsp;&nbsp;"]
    direction TB
    AN["<b>Pentaho Analyzer</b>&nbsp;&nbsp;<br/>self-service analysis&nbsp;&nbsp;"]:::output
    PRD["<b>Pentaho Report Designer</b>&nbsp;&nbsp;<br/>traditional and interactive reports&nbsp;&nbsp;"]:::output
    CT["<b>Pentaho CTools</b>&nbsp;&nbsp;<br/>custom reports and dashboards&nbsp;&nbsp;"]:::output
  end
  SV["<b>Pentaho DI and BA Server</b>&nbsp;&nbsp;<br/>scheduling, logging, security,&nbsp;&nbsp;<br/>repository (ETL, reports, models)&nbsp;&nbsp;"]:::server
  F -.-> ST
  R --> ST
  L --> ST
  O --> ST
  A --> ST
  ST -.-> TR
  TR -.-> CU
  TR -.-> DM
  CU -.-> AN
  CU --> PRD
  CU --> CT
  DM --> PRD
  DM --> CT
  ENG ~~~ SV

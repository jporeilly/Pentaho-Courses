%%{init: {"theme":"base","themeVariables":{"fontFamily":"Segoe UI, Helvetica, Arial, sans-serif","fontSize":"13px","lineColor":"#64748b","clusterBkg":"#fafaf9","clusterBorder":"#d6d3d1","edgeLabelBackground":"#ffffff"},"flowchart":{"curve":"linear","nodeSpacing":24,"rankSpacing":40,"padding":10,"htmlLabels":true}}}%%
flowchart LR
  classDef start fill:#dbeafe,stroke:#1d4ed8,color:#1e3a8a,text-align:left,rx:6,ry:6
  classDef entry fill:#ede9fe,stroke:#6d28d9,color:#3b0764,text-align:left,rx:6,ry:6
  classDef done fill:#dcfce7,stroke:#15803d,color:#14532d,text-align:left,rx:6,ry:6
  subgraph PAR["Run Next Entries in Parallel on Start: two threads"]
    direction LR
    S2["<div style='width:170px'><b>Start</b><br/>parallel</div>"]:::start
    A2["<div style='width:170px'><b>Transformation A</b><br/>thread 1</div>"]:::entry
    C2["<div style='width:170px'><b>Transformation C</b><br/>waits for A</div>"]:::entry
    W2["<div style='width:170px'><b>Success</b><br/>waits for C</div>"]:::done
    B2["<div style='width:170px'><b>Transformation B</b><br/>thread 2, same time as A</div>"]:::entry
    S2 -.-> A2 --> C2 --> W2
    S2 -.-> B2
  end
  subgraph SEQ["Default: one thread, depth-first"]
    direction LR
    S1["<div style='width:170px'><b>Start</b><br/>one at a time</div>"]:::start
    A1["<div style='width:170px'><b>Transformation A</b><br/>1st: the first hop</div>"]:::entry
    C1["<div style='width:170px'><b>Transformation C</b><br/>2nd</div>"]:::entry
    W1["<div style='width:170px'><b>Success</b><br/>3rd</div>"]:::done
    B1["<div style='width:170px'><b>Transformation B</b><br/>4th: after the whole branch</div>"]:::entry
    S1 --> A1 --> C1 --> W1
    S1 --> B1
  end

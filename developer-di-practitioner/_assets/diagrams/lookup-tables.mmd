    nvarchar(50) description
  }
  Customers {
    int customer_id PK
    varchar(100) name
    varchar(50) address
    char(5) ZIP
    nvarchar(50) city
    char(2) state_id FK
    char(3) country_id FK
  }
  Order_Status {
    char(2) status_id PK
    nvarchar(50) status_description
  }
  Order_Priorities {
    tinyint priority_id PK
    nvarchar(50) priority_description
  }
  Orders {
    int order_id PK
    datetime order_date
    int customer_id FK
    char(2) status_id FK
    tinyint priority_id FK
  }

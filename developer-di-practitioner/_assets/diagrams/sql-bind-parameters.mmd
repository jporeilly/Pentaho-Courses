%%{init: {"theme":"base","themeVariables":{"fontFamily":"Segoe UI, Helvetica, Arial, sans-serif","fontSize":"13px","lineColor":"#64748b","clusterBkg":"#fafaf9","clusterBorder":"#d6d3d1","edgeLabelBackground":"#ffffff"},"flowchart":{"curve":"linear","nodeSpacing":20,"rankSpacing":44,"padding":10,"htmlLabels":true}}}%%
flowchart LR
  classDef input fill:#dbeafe,stroke:#1d4ed8,color:#1e3a8a,text-align:left,rx:6,ry:6
  classDef query fill:#ede9fe,stroke:#6d28d9,color:#3b0764,text-align:left,rx:6,ry:6
  classDef output fill:#dcfce7,stroke:#15803d,color:#14532d,text-align:left,rx:6,ry:6
  subgraph BYROW["3. One value per row"]
    direction LR
    G3["<div style='width:170px'><b>Data grid</b><br/>two rows,<br/>one field each</div>"]:::input
    Q3["<div style='width:250px'><b>Table input</b><br/>Execute for each row? cleared<br/>the rows fill the ? markers in order</div>"]:::query
    O3["<div style='width:170px'><b>Result</b><br/>one execution<br/>one result set</div>"]:::output
    G3 --> Q3 --> O3
  end
  subgraph MANY["2. Several rows"]
    direction LR
    G2["<div style='width:170px'><b>Data grid</b><br/>three rows,<br/>two fields each</div>"]:::input
    Q2["<div style='width:250px'><b>Table input</b><br/>Execute for each row? selected<br/>each row fills the ? markers in turn</div>"]:::query
    O2["<div style='width:170px'><b>Result</b><br/>three executions<br/>one result set after another</div>"]:::output
    G2 --> Q2 --> O2
  end
  subgraph ONE["1. One row"]
    direction LR
    G1["<div style='width:170px'><b>Data grid</b><br/>one row,<br/>two fields</div>"]:::input
    Q1["<div style='width:250px'><b>Table input</b><br/>first field to the first ?<br/>second field to the second ?</div>"]:::query
    O1["<div style='width:170px'><b>Result</b><br/>one execution<br/>one result set</div>"]:::output
    G1 --> Q1 --> O1
  end

<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>solution_build_pipeline</name>
    <description>Lab 2 solution: validating ingest with a reject file</description>
    <extended_description>Reads C:/Workshop/pdi-2hr/sales_20260101.csv, routes rows missing customer_id or product_id to a reject CSV for the source team, and passes valid rows downstream. Compare with your own build - step names may differ, structure should match.</extended_description>
    <trans_version>1.0</trans_version>
    <trans_type>Normal</trans_type>
    <trans_status>0</trans_status>
    <directory>/</directory>
    <parameters>
    </parameters>
  </info>

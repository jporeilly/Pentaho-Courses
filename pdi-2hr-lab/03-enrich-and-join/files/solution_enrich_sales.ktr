  <info>
    <name>solution_enrich_sales</name>
    <description>First win: read yesterday's sales, catch the bad rows</description>
    <extended_description>Reads sales_20260101.csv (which contains two rows with missing keys), routes rows missing customer_id or product_id to a reject stream, and passes the rest through. Preview either branch to see the data at that point in the flow.</extended_description>

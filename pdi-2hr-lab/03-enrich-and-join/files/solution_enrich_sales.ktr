<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>solution_enrich_sales</name>
    <description>Lab 3 solution: three sources joined, margin computed</description>
    <extended_description>Validated sales (CSV) enriched with the JSON customer master and the product catalogue via two Stream lookups, then revenue and margin computed in a Calculator. Expects sales in the 02-see-it-work workshop folder and the master data in 03-make-it-yours/03-enrich-and-join/.</extended_description>
    <trans_version>1.0</trans_version>
    <trans_type>Normal</trans_type>
    <trans_status>0</trans_status>
    <directory>/</directory>
    <parameters>
    </parameters>
  </info>
  <notepads>
    <notepad>
      <note>SOLUTION - Lab 3. Data files expected in their workshop folders (02-see-it-work, 03-make-it-yours).
Preview "Compute margin" to see the enriched rows.</note>
      <xloc>48</xloc>
      <yloc>16</yloc>
      <width>420</width>
      <heigth>50</heigth>
      <fontname>Segoe UI</fontname>
      <fontsize>10</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>14</fontcolorred>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorblue>90</fontcolorblue>
      <backgroundcolorred>201</backgroundcolorred>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorblue>251</backgroundcolorblue>
      <bordercolorred>14</bordercolorred>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorblue>90</bordercolorblue>
      <drawshadow>N</drawshadow>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>Read sales</from>
      <to>Keys present?</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Keys present?</from>
      <to>+ customer</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Keys present?</from>
      <to>Rejects for source team</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Read customers</from>
      <to>+ customer</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>+ customer</from>
      <to>+ product</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Read products</from>
      <to>+ product</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>+ product</from>
      <to>Compute margin</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Compute margin</from>
      <to>Enriched rows</to>
      <enabled>Y</enabled>
    </hop>
  </order>

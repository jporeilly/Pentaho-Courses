<?xml version="1.0" encoding="UTF-8"?>
<job>
  <name>solution_mi_driver</name>
  <description>Lab 5 solution: run the injection once per control row</description>
  <extended_description>Reads control.csv, then executes solution_mi_inject.ktr once for every row, mapping the row's filename and separator onto the FEED_FILE / FEED_SEP parameters. Add a feed by adding a line to control.csv - no pipeline changes.</extended_description>
  <job_version/>
  <job_status>0</job_status>
  <directory>/</directory>
  <created_user>-</created_user>
  <created_date>2026/09/01 12:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/09/01 12:00:00.000</modified_date>
  <parameters>
    </parameters>
  <slaveservers>
    </slaveservers>
  <pass_batchid>N</pass_batchid>
  <shared_objects_file/>
  <entries>
    <entry>
      <name>START</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <start>Y</start>
      <dummy>N</dummy>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <hour>12</hour>
      <minutes>0</minutes>
      <weekDay>1</weekDay>
      <DayOfMonth>1</DayOfMonth>
      <parallel>N</parallel>
      <draw>Y</draw>
      <nr>0</nr>
      <xloc>80</xloc>
      <yloc>160</yloc>
      <attributes_kjc/>
    </entry>
    <entry>
      <name>Read control file</name>
      <description/>
